# ============================================
# 锋锋の小站 - 环境变量配置
# 复制本文件为 .env 并填写实际值（.env 已被 gitignore，不会提交）
# ============================================

# 服务端口（Railway / Render 等平台会自动注入 PORT，本地无需设置）
# PORT=3000

# 数据文件目录（配合 Railway Volume 持久化时设为挂载路径，例如 /data）
# DATA_PATH=/data

# 管理员账号（仅在首次初始化 data.json 时生效；
# 之后请登录后台在「设置 → 安全设置」中修改密码）
ADMIN_USERNAME=admin

# 管理员密码 —— 强烈建议替换为强密码！
# 生成方式任选其一：
#   openssl rand -base64 12
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# 或使用密码管理器生成
ADMIN_PASSWORD=change-me-to-a-strong-password
